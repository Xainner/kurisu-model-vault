# Kurisu Model Vault Configuration

# Public port for the web interface
APP_PORT=17012

# Backend internal port
BACKEND_PORT=8000

# Directory where models are stored (mounted in container)
MODEL_DIR=/mnt/cloud1/modelos

# HuggingFace token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# JWT secret for session tokens (change in production!)
JWT_SECRET=kurisu-vault-secret-change-in-prod
